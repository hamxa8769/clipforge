*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
# NOTE: build-artifact dirs below are root-scoped (leading /) so they
# never swallow source dirs such as apps/web/lib/.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
*.local.json
*.keystore
*.jks
*.pem
*.key
credentials*.json
service-account*.json
# Encrypted token/credential store + app settings (live secrets, machine key)
data/secrets/
data/settings.json

# User media & generated outputs
data/uploads/
data/clips/
data/exports/
data/smoke/
data/transcripts/
*.db
*.sqlite3
*.mp4
*.mov
*.mkv
*.webm
*.mp3
*.wav
*.srt
*.ass
!**/fixtures/*.mp4

