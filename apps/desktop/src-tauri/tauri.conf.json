{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* https://ffmpeg.org; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data:; font-src 'self'"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "label": "main",
        "minHeight": 700,
        "minWidth": 1100,
        "resizable": true,
        "title": "ClipForge",
        "width": 1280
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "category": "Video",
    "copyright": "ClipForge",
    "externalBin": [
      "binaries/clipforge-server"
    ],
    "resources": [
      "binaries/web/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "identifier": "com.clipforge.app",
  "productName": "ClipForge",
  "version": "0.9.2"
}