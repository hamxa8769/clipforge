# ClipForge — environment template
# Copy to .env and fill in. NEVER commit a filled-in .env.
# All provider keys are OPTIONAL in v0.1.0: without them ClipForge runs in
# dry-run / manual-post-pack mode (clips + SEO are generated locally, nothing
# is published to any platform).

# --- Core -----------------------------------------------------------------
# Dry-run mode: when true, publishing adapters log the request instead of
# calling the platform API. Default true. Set false only with real, approved
# OAuth tokens and after a human has approved the post.
DRY_RUN=true

# Local file storage ("local") or object storage ("s3"/"r2") for uploads/clips.
STORAGE_BACKEND=local
# Local storage root (relative to repo root). Ignored for s3/r2.
STORAGE_LOCAL_ROOT=data

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL. SQLite is fine for local dev; use Postgres in production.
DATABASE_URL=sqlite:///./data/clipforge.db
# Example Postgres:
# DATABASE_URL=postgresql+psycopg2://clipforge:CHANGE_ME@localhost:5432/clipforge

# --- Queue (Phase 2; v0.1.0 runs jobs inline / via the API worker) ----------
REDIS_URL=redis://localhost:6379/0

# --- Auth / API --------------------------------------------------------------
# Secret used to sign session/API tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_VALUE

# --- LLM providers (optional; transcription/highlights/SEO fall back to ------
# --- heuristics when no key is configured) ----------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- YouTube (Google Cloud OAuth 2.0, Data API v3) — optional ---------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# --- Meta: Facebook Pages + Instagram (Graph API) — optional ----------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback

# --- TikTok (Content Posting API + Login Kit) — optional ----------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/auth/tiktok/callback
